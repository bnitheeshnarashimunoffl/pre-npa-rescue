# Copy to .env and adjust. Never commit .env. Every variable has a safe dev default (A11).

# --- determinism / data (WS1, WS2, WS7)
SEED=42
DATA_DIR=./data/generated
RAW_DATA_DIR=./data/raw
# CI uses 2000; the full demo run uses 500000
DATAGEN_N_CUSTOMERS=10000
AS_OF_MONTH=2026-09

# --- models and policy (WS2, WS3, WS5)
MODEL_DIR=./packages/models/artifacts
POLICY_PATH=./packages/rules/policies/bank_policy.yaml
CONTRACTS_DIR=./contracts

# --- API (WS5)
DATABASE_URL=postgresql+psycopg://npa:npa@localhost:5432/npa
# Dev only. Must be >= 32 bytes (HS256); use a long random value on any shared deployment.
JWT_SECRET=change-me-dev-only-0123456789abcdef
JWT_EXPIRE_MINUTES=120
# In-memory rate limits (per process): login per client+username, chat per user
LOGIN_RATE_PER_MINUTE=10
CHAT_RATE_PER_MINUTE=30
# Comma-separated extra CORS origins (e.g. the Vercel domain); localhost:3000 is always allowed
CORS_ORIGINS=

# --- container startup (app.entrypoint, task 5.5)
RUN_MIGRATIONS=true
# Seed an empty database on start (docker compose / Render set true)
SEED_ON_START=false
WAIT_FOR_DB_SECONDS=60
# Keep 1: login/chat rate limits are in-memory per process
WEB_CONCURRENCY=1

# --- LLM (WS4, WS7). Use "anthropic" only for real runs; CI is always "mock".
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- web (WS6, WS7)
API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=true

# --- misc
TZ_BUSINESS=Asia/Kolkata
LOG_LEVEL=INFO
