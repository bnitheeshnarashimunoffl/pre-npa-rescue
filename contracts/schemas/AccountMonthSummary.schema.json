{
  "$defs": {
    "Bucket": {
      "description": "Delinquency bucket from days past due (see ``constants.BUCKET_THRESHOLDS``).\n\ndpd 0 -> current; 1-30 -> sma0; 31-60 -> sma1; 61-90 -> sma2; >90 -> npa.",
      "enum": [
        "current",
        "sma0",
        "sma1",
        "sma2",
        "npa"
      ],
      "title": "Bucket",
      "type": "string"
    }
  },
  "$id": "AccountMonthSummary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bucket": {
      "$ref": "#/$defs/Bucket"
    },
    "dpd": {
      "minimum": 0,
      "title": "Dpd",
      "type": "integer"
    },
    "min_due_paise": {
      "description": "Amount in paise (1 rupee = 100 paise).",
      "minimum": 0,
      "title": "Min Due Paise",
      "type": "integer"
    },
    "month": {
      "examples": [
        "2026-09"
      ],
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "title": "Month",
      "type": "string"
    },
    "payments_paise": {
      "description": "Amount in paise (1 rupee = 100 paise).",
      "minimum": 0,
      "title": "Payments Paise",
      "type": "integer"
    },
    "total_due_paise": {
      "description": "Amount in paise (1 rupee = 100 paise).",
      "minimum": 0,
      "title": "Total Due Paise",
      "type": "integer"
    }
  },
  "required": [
    "month",
    "total_due_paise",
    "min_due_paise",
    "payments_paise",
    "dpd",
    "bucket"
  ],
  "title": "AccountMonthSummary",
  "type": "object",
  "x-contract-version": "0.2.1"
}
