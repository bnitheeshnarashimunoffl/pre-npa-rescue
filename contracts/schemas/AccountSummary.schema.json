{
  "$defs": {
    "AccountMonthSummary": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "$ref": "#/$defs/Bucket"
        },
        "dpd": {
          "minimum": 0,
          "title": "Dpd",
          "type": "integer"
        },
        "min_due_paise": {
          "description": "Amount in paise (1 rupee = 100 paise).",
          "minimum": 0,
          "title": "Min Due Paise",
          "type": "integer"
        },
        "month": {
          "examples": [
            "2026-09"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Month",
          "type": "string"
        },
        "payments_paise": {
          "description": "Amount in paise (1 rupee = 100 paise).",
          "minimum": 0,
          "title": "Payments Paise",
          "type": "integer"
        },
        "total_due_paise": {
          "description": "Amount in paise (1 rupee = 100 paise).",
          "minimum": 0,
          "title": "Total Due Paise",
          "type": "integer"
        }
      },
      "required": [
        "month",
        "total_due_paise",
        "min_due_paise",
        "payments_paise",
        "dpd",
        "bucket"
      ],
      "title": "AccountMonthSummary",
      "type": "object"
    },
    "Actor": {
      "enum": [
        "bot",
        "agent",
        "hardship_officer",
        "system",
        "customer"
      ],
      "title": "Actor",
      "type": "string"
    },
    "Bucket": {
      "description": "Delinquency bucket from days past due (see ``constants.BUCKET_THRESHOLDS``).\n\ndpd 0 -> current; 1-30 -> sma0; 31-60 -> sma1; 61-90 -> sma2; >90 -> npa.",
      "enum": [
        "current",
        "sma0",
        "sma1",
        "sma2",
        "npa"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "Channel": {
      "enum": [
        "chat",
        "whatsapp_sim",
        "sms",
        "email",
        "call",
        "voice_sim"
      ],
      "title": "Channel",
      "type": "string"
    },
    "ComplianceDecision": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "next_allowed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Allowed At"
        },
        "rule_ids": {
          "examples": [
            [
              "RBI-454Y4-WINDOW"
            ]
          ],
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "allowed",
        "rule_ids",
        "next_allowed_at",
        "explanation"
      ],
      "title": "ComplianceDecision",
      "type": "object"
    },
    "ContactEvent": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "compliance": {
          "$ref": "#/$defs/ComplianceDecision"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "outbound",
            "inbound"
          ],
          "title": "Direction",
          "type": "string"
        },
        "event_id": {
          "examples": [
            "EVT-1b4e28ba-2fa1-11d2-883f-0016d3cca427"
          ],
          "title": "Event Id",
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/Lang"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome"
        },
        "recorded_notice_given": {
          "title": "Recorded Notice Given",
          "type": "boolean"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "customer_id",
        "account_id",
        "channel",
        "direction",
        "actor",
        "ts",
        "content",
        "lang",
        "recorded_notice_given",
        "compliance",
        "outcome"
      ],
      "title": "ContactEvent",
      "type": "object"
    },
    "Lang": {
      "enum": [
        "en",
        "ta",
        "hi"
      ],
      "title": "Lang",
      "type": "string"
    },
    "NextAction": {
      "enum": [
        "no_contact",
        "reminder",
        "chat_invite",
        "agent_call",
        "hardship_officer",
        "firm_process"
      ],
      "title": "NextAction",
      "type": "string"
    },
    "NextBestAction": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/NextAction"
        },
        "channel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "earliest_contact_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Earliest Contact At"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/RiskScore"
        },
        "segment": {
          "$ref": "#/$defs/SegmentResult"
        },
        "uplift": {
          "$ref": "#/$defs/UpliftResult"
        }
      },
      "required": [
        "account_id",
        "action",
        "channel",
        "earliest_contact_at",
        "reason_codes",
        "risk",
        "segment",
        "uplift"
      ],
      "title": "NextBestAction",
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved By"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "offer_id": {
          "examples": [
            "OFFER-1b4e28ba-2fa1-11d2-883f-0016d3cca427"
          ],
          "title": "Offer Id",
          "type": "string"
        },
        "option": {
          "$ref": "#/$defs/ReliefOption"
        },
        "proposed_by": {
          "$ref": "#/$defs/Actor"
        },
        "status": {
          "$ref": "#/$defs/OfferStatus"
        }
      },
      "required": [
        "offer_id",
        "customer_id",
        "account_id",
        "option",
        "status",
        "proposed_by",
        "approved_by",
        "created_at",
        "expires_at"
      ],
      "title": "Offer",
      "type": "object"
    },
    "OfferStatus": {
      "enum": [
        "proposed",
        "approved",
        "presented",
        "accepted",
        "rejected",
        "expired"
      ],
      "title": "OfferStatus",
      "type": "string"
    },
    "ReasonCode": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "examples": [
            "SALARY_STOPPED"
          ],
          "title": "Code",
          "type": "string"
        },
        "text": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/Lang"
          },
          "title": "Text",
          "type": "object"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "code",
        "weight",
        "text"
      ],
      "title": "ReasonCode",
      "type": "object"
    },
    "ReliefOption": {
      "additionalProperties": false,
      "properties": {
        "disclosure_keys": {
          "description": "i18n keys of mandatory trade-off texts.",
          "items": {
            "type": "string"
          },
          "title": "Disclosure Keys",
          "type": "array"
        },
        "eligibility_reason": {
          "title": "Eligibility Reason",
          "type": "string"
        },
        "monthly_amount_paise": {
          "anyOf": [
            {
              "description": "Amount in paise (1 rupee = 100 paise).",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Monthly Amount Paise"
        },
        "option_id": {
          "title": "Option Id",
          "type": "string"
        },
        "policy_ref": {
          "examples": [
            "bank_policy.yaml#fee_waiver.v1"
          ],
          "title": "Policy Ref",
          "type": "string"
        },
        "regulatory_refs": {
          "examples": [
            [
              "RBI Prudential Framework 2019"
            ]
          ],
          "items": {
            "type": "string"
          },
          "title": "Regulatory Refs",
          "type": "array"
        },
        "requires_human_approval": {
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "settlement_amount_paise": {
          "anyOf": [
            {
              "description": "Amount in paise (1 rupee = 100 paise).",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Settlement Amount Paise"
        },
        "tenure_months": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tenure Months"
        },
        "type": {
          "$ref": "#/$defs/ReliefType"
        },
        "waiver_paise": {
          "anyOf": [
            {
              "description": "Amount in paise (1 rupee = 100 paise).",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Waiver Paise"
        }
      },
      "required": [
        "option_id",
        "type",
        "monthly_amount_paise",
        "tenure_months",
        "waiver_paise",
        "settlement_amount_paise",
        "policy_ref",
        "regulatory_refs",
        "disclosure_keys",
        "requires_human_approval",
        "eligibility_reason"
      ],
      "title": "ReliefOption",
      "type": "object"
    },
    "ReliefType": {
      "enum": [
        "fee_waiver",
        "emi_conversion",
        "restructuring",
        "compromise_settlement",
        "insurance_referral",
        "review_date"
      ],
      "title": "ReliefType",
      "type": "string"
    },
    "RiskBand": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskBand",
      "type": "string"
    },
    "RiskScore": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "as_of_month": {
          "examples": [
            "2026-09"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "As Of Month",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "p_roll_forward": {
          "description": "Probability of rolling forward in 30-60 days.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Roll Forward",
          "type": "number"
        },
        "reasons": {
          "description": "Top 3 reasons.",
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "maxItems": 3,
          "title": "Reasons",
          "type": "array"
        },
        "risk_band": {
          "$ref": "#/$defs/RiskBand"
        }
      },
      "required": [
        "account_id",
        "as_of_month",
        "p_roll_forward",
        "risk_band",
        "reasons",
        "model_version"
      ],
      "title": "RiskScore",
      "type": "object"
    },
    "Segment": {
      "enum": [
        "forgot",
        "cant_pay",
        "wont_pay",
        "not_at_risk"
      ],
      "title": "Segment",
      "type": "string"
    },
    "SegmentResult": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "segment": {
          "$ref": "#/$defs/Segment"
        }
      },
      "required": [
        "account_id",
        "segment",
        "confidence",
        "model_version"
      ],
      "title": "SegmentResult",
      "type": "object"
    },
    "Treatment": {
      "enum": [
        "none",
        "reminder",
        "chat_invite",
        "agent_call",
        "relief_offer"
      ],
      "title": "Treatment",
      "type": "string"
    },
    "UpliftGroup": {
      "enum": [
        "persuadable",
        "sure_thing",
        "lost_cause",
        "sleeping_dog"
      ],
      "title": "UpliftGroup",
      "type": "string"
    },
    "UpliftResult": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "recommended_treatment": {
          "$ref": "#/$defs/Treatment"
        },
        "uplift_group": {
          "$ref": "#/$defs/UpliftGroup"
        },
        "uplift_score": {
          "description": "Estimated cure-probability gain if treated.",
          "title": "Uplift Score",
          "type": "number"
        }
      },
      "required": [
        "account_id",
        "uplift_score",
        "uplift_group",
        "recommended_treatment",
        "model_version"
      ],
      "title": "UpliftResult",
      "type": "object"
    }
  },
  "$id": "AccountSummary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "title": "Account Id",
      "type": "string"
    },
    "bucket": {
      "$ref": "#/$defs/Bucket"
    },
    "contacts": {
      "items": {
        "$ref": "#/$defs/ContactEvent"
      },
      "title": "Contacts",
      "type": "array"
    },
    "customer_id": {
      "title": "Customer Id",
      "type": "string"
    },
    "customer_name": {
      "title": "Customer Name",
      "type": "string"
    },
    "dpd": {
      "minimum": 0,
      "title": "Dpd",
      "type": "integer"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/AccountMonthSummary"
      },
      "title": "History",
      "type": "array"
    },
    "min_due_paise": {
      "description": "Amount in paise (1 rupee = 100 paise).",
      "minimum": 0,
      "title": "Min Due Paise",
      "type": "integer"
    },
    "nba": {
      "anyOf": [
        {
          "$ref": "#/$defs/NextBestAction"
        },
        {
          "type": "null"
        }
      ]
    },
    "offers": {
      "items": {
        "$ref": "#/$defs/Offer"
      },
      "title": "Offers",
      "type": "array"
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reasons",
      "type": "array"
    },
    "total_due_paise": {
      "description": "Amount in paise (1 rupee = 100 paise).",
      "minimum": 0,
      "title": "Total Due Paise",
      "type": "integer"
    }
  },
  "required": [
    "account_id",
    "customer_id",
    "customer_name",
    "bucket",
    "dpd",
    "total_due_paise",
    "min_due_paise",
    "history",
    "contacts",
    "offers",
    "reasons",
    "nba"
  ],
  "title": "AccountSummary",
  "type": "object",
  "x-contract-version": "0.1.0"
}
