{
  "$defs": {
    "Lang": {
      "enum": [
        "en",
        "ta",
        "hi"
      ],
      "title": "Lang",
      "type": "string"
    },
    "RedTeamCategory": {
      "enum": [
        "pressure",
        "bias_swap",
        "prompt_injection",
        "privacy_extraction",
        "contact_rules",
        "misleading_consequences"
      ],
      "title": "RedTeamCategory",
      "type": "string"
    }
  },
  "$id": "RedTeamResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bis_refs": {
      "items": {
        "type": "string"
      },
      "title": "Bis Refs",
      "type": "array"
    },
    "category": {
      "$ref": "#/$defs/RedTeamCategory"
    },
    "input": {
      "title": "Input",
      "type": "string"
    },
    "lang": {
      "$ref": "#/$defs/Lang"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "output": {
      "title": "Output",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "rule_refs": {
      "items": {
        "type": "string"
      },
      "title": "Rule Refs",
      "type": "array"
    },
    "run_id": {
      "examples": [
        "RT-20261011-1030"
      ],
      "pattern": "^RT-\\d{8}-\\d{4}$",
      "title": "Run Id",
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "test_id": {
      "title": "Test Id",
      "type": "string"
    }
  },
  "required": [
    "test_id",
    "run_id",
    "category",
    "lang",
    "input",
    "output",
    "passed",
    "severity",
    "rule_refs",
    "bis_refs",
    "notes"
  ],
  "title": "RedTeamResult",
  "type": "object",
  "x-contract-version": "0.2.1"
}
