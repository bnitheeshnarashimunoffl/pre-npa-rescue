{
  "$defs": {
    "Lang": {
      "enum": [
        "en",
        "ta",
        "hi"
      ],
      "title": "Lang",
      "type": "string"
    },
    "RedTeamCategory": {
      "enum": [
        "pressure",
        "bias_swap",
        "prompt_injection",
        "privacy_extraction",
        "contact_rules",
        "misleading_consequences"
      ],
      "title": "RedTeamCategory",
      "type": "string"
    },
    "RedTeamResult": {
      "additionalProperties": false,
      "properties": {
        "bis_refs": {
          "items": {
            "type": "string"
          },
          "title": "Bis Refs",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/RedTeamCategory"
        },
        "input": {
          "title": "Input",
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/Lang"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "rule_refs": {
          "items": {
            "type": "string"
          },
          "title": "Rule Refs",
          "type": "array"
        },
        "run_id": {
          "examples": [
            "RT-20261011-1030"
          ],
          "pattern": "^RT-\\d{8}-\\d{4}$",
          "title": "Run Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "test_id": {
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "run_id",
        "category",
        "lang",
        "input",
        "output",
        "passed",
        "severity",
        "rule_refs",
        "bis_refs",
        "notes"
      ],
      "title": "RedTeamResult",
      "type": "object"
    },
    "Scorecard": {
      "additionalProperties": false,
      "properties": {
        "bis_coverage": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Bis Coverage",
          "type": "object"
        },
        "by_category": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "propertyNames": {
            "$ref": "#/$defs/RedTeamCategory"
          },
          "title": "By Category",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "rbi_coverage": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Rbi Coverage",
          "type": "object"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/RedTeamResult"
          },
          "title": "Results",
          "type": "array"
        },
        "run_id": {
          "pattern": "^RT-\\d{8}-\\d{4}$",
          "title": "Run Id",
          "type": "string"
        },
        "totals": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Totals",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "totals",
        "by_category",
        "results",
        "rbi_coverage",
        "bis_coverage"
      ],
      "title": "Scorecard",
      "type": "object"
    }
  },
  "$id": "RedTeamRun.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "run_id": {
      "pattern": "^RT-\\d{8}-\\d{4}$",
      "title": "Run Id",
      "type": "string"
    },
    "scorecard": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scorecard"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status",
    "created_at",
    "finished_at",
    "scorecard"
  ],
  "title": "RedTeamRun",
  "type": "object",
  "x-contract-version": "0.2.1"
}
