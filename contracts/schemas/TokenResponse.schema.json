{
  "$defs": {
    "Role": {
      "enum": [
        "customer",
        "collector",
        "hardship_officer",
        "admin",
        "auditor"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "$id": "TokenResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_token": {
      "title": "Access Token",
      "type": "string"
    },
    "customer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set only for the customer role.",
      "title": "Customer Id"
    },
    "expires_in": {
      "description": "Seconds until expiry.",
      "title": "Expires In",
      "type": "integer"
    },
    "role": {
      "$ref": "#/$defs/Role"
    },
    "token_type": {
      "const": "bearer",
      "default": "bearer",
      "title": "Token Type",
      "type": "string"
    }
  },
  "required": [
    "access_token",
    "expires_in",
    "role",
    "customer_id"
  ],
  "title": "TokenResponse",
  "type": "object",
  "x-contract-version": "0.1.1"
}
