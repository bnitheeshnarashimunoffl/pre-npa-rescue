{
  "$defs": {
    "AffordabilityPolicy": {
      "additionalProperties": false,
      "properties": {
        "affordability_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Affordability Ratio"
        },
        "dependant_allowance_paise": {
          "minimum": 0,
          "title": "Dependant Allowance Paise",
          "type": "integer"
        },
        "estimated_essentials_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Estimated Essentials Pct"
        }
      },
      "required": [
        "affordability_ratio",
        "dependant_allowance_paise",
        "estimated_essentials_pct"
      ],
      "title": "AffordabilityPolicy",
      "type": "object"
    },
    "Bucket": {
      "description": "Delinquency bucket from days past due (see ``constants.BUCKET_THRESHOLDS``).\n\ndpd 0 -> current; 1-30 -> sma0; 31-60 -> sma1; 61-90 -> sma2; >90 -> npa.",
      "enum": [
        "current",
        "sma0",
        "sma1",
        "sma2",
        "npa"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "ChargesPolicy": {
      "additionalProperties": false,
      "properties": {
        "late_fee_slabs": {
          "items": {
            "$ref": "#/$defs/LateFeeSlabSpec"
          },
          "minItems": 1,
          "title": "Late Fee Slabs",
          "type": "array"
        },
        "card_interest_rate_annual_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Card Interest Rate Annual Pct"
        },
        "mad_principal_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Mad Principal Pct"
        },
        "mad_floor_paise": {
          "minimum": 0,
          "title": "Mad Floor Paise",
          "type": "integer"
        }
      },
      "required": [
        "late_fee_slabs",
        "card_interest_rate_annual_pct",
        "mad_principal_pct",
        "mad_floor_paise"
      ],
      "title": "ChargesPolicy",
      "type": "object"
    },
    "ContactPolicy": {
      "additionalProperties": false,
      "properties": {
        "window_local": {
          "$ref": "#/$defs/ContactWindow"
        },
        "max_outbound_attempts_per_day": {
          "minimum": 1,
          "title": "Max Outbound Attempts Per Day",
          "type": "integer"
        },
        "max_outbound_attempts_per_week": {
          "minimum": 1,
          "title": "Max Outbound Attempts Per Week",
          "type": "integer"
        },
        "min_gap_minutes_between_attempts": {
          "minimum": 0,
          "title": "Min Gap Minutes Between Attempts",
          "type": "integer"
        },
        "do_not_contact_flags": {
          "items": {
            "type": "string"
          },
          "title": "Do Not Contact Flags",
          "type": "array"
        }
      },
      "required": [
        "window_local",
        "max_outbound_attempts_per_day",
        "max_outbound_attempts_per_week",
        "min_gap_minutes_between_attempts",
        "do_not_contact_flags"
      ],
      "title": "ContactPolicy",
      "type": "object"
    },
    "ContactWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "time",
          "title": "End",
          "type": "string"
        },
        "tz": {
          "title": "Tz",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "tz"
      ],
      "title": "ContactWindow",
      "type": "object"
    },
    "CreditBureauPolicy": {
      "additionalProperties": false,
      "properties": {
        "notify_before_default_report": {
          "title": "Notify Before Default Report",
          "type": "boolean"
        },
        "update_after_settlement_days": {
          "minimum": 1,
          "title": "Update After Settlement Days",
          "type": "integer"
        }
      },
      "required": [
        "notify_before_default_report",
        "update_after_settlement_days"
      ],
      "title": "CreditBureauPolicy",
      "type": "object"
    },
    "EmiPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "requires_human_approval": {
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "policy_ref": {
          "title": "Policy Ref",
          "type": "string"
        },
        "regulatory_refs": {
          "items": {
            "type": "string"
          },
          "title": "Regulatory Refs",
          "type": "array"
        },
        "disclosure_keys": {
          "items": {
            "type": "string"
          },
          "title": "Disclosure Keys",
          "type": "array"
        },
        "eligible_buckets": {
          "default": [
            "current",
            "sma0",
            "sma1",
            "sma2",
            "npa"
          ],
          "items": {
            "$ref": "#/$defs/Bucket"
          },
          "title": "Eligible Buckets",
          "type": "array"
        },
        "tenures_months": {
          "items": {
            "maximum": 120,
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Tenures Months",
          "type": "array"
        },
        "interest_rate_annual_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Interest Rate Annual Pct"
        },
        "min_emi_paise": {
          "minimum": 0,
          "title": "Min Emi Paise",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "requires_human_approval",
        "policy_ref",
        "regulatory_refs",
        "disclosure_keys",
        "tenures_months",
        "interest_rate_annual_pct",
        "min_emi_paise"
      ],
      "title": "EmiPolicy",
      "type": "object"
    },
